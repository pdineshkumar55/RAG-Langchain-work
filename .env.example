# Copy this file to .env and fill in your keys.
# Never commit .env.

# Required: https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-key

# Optional: LangSmith tracing (https://smith.langchain.com/)
# Leave LANGCHAIN_API_KEY empty and set LANGCHAIN_TRACING_V2=false to turn tracing off.
LANGCHAIN_API_KEY=your-langsmith-key
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=Multi-PDF-RAG
